<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Digital Drift</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/styles/main.css"/>
</head>
<body>

  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="site-title">✦ Digital Drift</a>
      <nav class="header-nav">
        <% if (user) { %>
          <a class="btn btn-new" href="/new">+ New Post</a>
          <div class="user-chip">
            <% if (user.avatar_url) { %>
              <img class="user-avatar" src="<%= user.avatar_url %>" alt="avatar"/>
            <% } %>
            <span class="user-name"><%= user.display_name %></span>
            <a class="btn btn-logout" href="/auth/logout">Logout</a>
          </div>
        <% } else { %>
          <a class="btn btn-google" href="/auth/google">
            <svg width="18" height="18" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.95 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
            Sign in with Google
          </a>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="container">

    <% if (posts.length === 0) { %>
      <div class="empty-state">
        <p class="empty-icon">📝</p>
        <p>No posts yet.</p>
        <% if (user) { %>
          <a href="/new" class="btn btn-new" style="margin-top:16px;">Write the first post</a>
        <% } else { %>
          <p style="margin-top:12px;color:var(--text-light);font-size:0.85rem;">Sign in to be the first to post.</p>
        <% } %>
      </div>
    <% } %>

    <ul class="posts-list">
      <% posts.forEach(post => { %>
        <li class="post-card">
          <div class="post-meta-top">
            <div class="post-author-row">
              <% if (post.avatar_url) { %>
                <img class="post-avatar" src="<%= post.avatar_url %>" alt=""/>
              <% } %>
              <span class="post-author">✦ <%= post.author_name || post.author %></span>
            </div>
            <span class="post-date"><%= fmtDate(post.date) %></span>
          </div>
          <h2 class="post-title"><%= post.title %></h2>
          <p class="post-content"><%= post.content %></p>

          <!-- Show edit/delete ONLY to the post owner -->
          <% if (user && post.user_id === user.id) { %>
            <div class="post-actions">
              <a class="btn btn-edit" href="/edit/<%= post.id %>">✏️ Edit</a>
              <a class="btn btn-delete" href="/posts/delete/<%= post.id %>"
                 onclick="return confirm('Delete this post?')">🗑 Delete</a>
            </div>
          <% } %>
        </li>
      <% }); %>
    </ul>

  </main>

  <footer class="site-footer">
    <p>Built with Express · EJS · Neon · Google OAuth 🌸</p>
  </footer>

</body>
</html>
