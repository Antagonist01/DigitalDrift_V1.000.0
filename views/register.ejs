<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Create Account — Digital Drift</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/styles/main.css"/>
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="site-title">✦ Digital Drift</a>
    </div>
  </header>

  <main class="container">
    <div class="auth-card">
      <div class="auth-icon">🌸</div>
      <h1 class="auth-title">Create account</h1>
      <p class="auth-sub">Join to start writing your own posts</p>

      <% if (error) { %>
        <div class="auth-error"><%= error %></div>
      <% } %>

      <!-- ── Google OAuth (fastest) ── -->
      <a class="btn btn-google btn-google-large" href="/auth/google">
        <svg width="20" height="20" viewBox="0 0 48 48">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
          <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
          <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.95 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
        </svg>
        Sign up with Google
      </a>

      <div class="auth-divider"><span>or create with email</span></div>

      <!-- ── Registration form ── -->
      <form class="auth-form" method="POST" action="/auth/register" id="regForm">
        <div class="field-group">
          <label for="display_name">Display name</label>
          <input id="display_name" type="text" name="display_name"
            placeholder="How you'll appear on posts" required minlength="2" maxlength="60"/>
        </div>

        <div class="field-group">
          <label for="email">Email address</label>
          <input id="email" type="email" name="email"
            placeholder="you@example.com" required autocomplete="email"/>
        </div>

        <div class="field-group">
          <label for="password">
            Password
            <button type="button" class="show-pwd-btn" onclick="togglePwd('password', this)">Show</button>
          </label>
          <input id="password" type="password" name="password"
            placeholder="Min 8 chars, mixed case, number, symbol"
            required minlength="8" autocomplete="new-password"
            oninput="checkStrength(this.value)"/>
          <!-- Live strength bar -->
          <div class="pwd-strength-bar">
            <div class="pwd-strength-fill" id="strengthFill"></div>
          </div>
          <p class="pwd-strength-label" id="strengthLabel"></p>
        </div>

        <div class="field-group">
          <label for="confirm_password">
            Confirm password
            <button type="button" class="show-pwd-btn" onclick="togglePwd('confirm_password', this)">Show</button>
          </label>
          <input id="confirm_password" type="password" name="confirm_password"
            placeholder="Repeat your password"
            required autocomplete="new-password"/>
        </div>

        <div class="pwd-rules">
          <p>Password must contain:</p>
          <ul>
            <li id="r-len">At least 8 characters</li>
            <li id="r-upper">One uppercase letter (A–Z)</li>
            <li id="r-lower">One lowercase letter (a–z)</li>
            <li id="r-digit">One number (0–9)</li>
            <li id="r-special">One special character (!@#$%…)</li>
          </ul>
        </div>

        <button class="btn btn-submit" type="submit">Create Account</button>
      </form>

      <p class="auth-switch">
        Already have an account? <a href="/auth/login">Sign in</a>
      </p>
    </div>
  </main>

  <footer class="site-footer">
    <p>Built with Express · EJS · Neon · Google OAuth 🌸</p>
  </footer>

  <script>
    function togglePwd(id, btn) {
      const input = document.getElementById(id);
      const show  = input.type === "password";
      input.type  = show ? "text" : "password";
      btn.textContent = show ? "Hide" : "Show";
    }

    function checkStrength(val) {
      const rules = {
        "r-len":     val.length >= 8,
        "r-upper":   /[A-Z]/.test(val),
        "r-lower":   /[a-z]/.test(val),
        "r-digit":   /[0-9]/.test(val),
        "r-special": /[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(val),
      };

      let passed = 0;
      for (const [id, ok] of Object.entries(rules)) {
        const el = document.getElementById(id);
        el.style.color = ok ? "var(--mint-dark, #3a8c5c)" : "var(--text-light)";
        el.style.fontWeight = ok ? "500" : "300";
        if (ok) passed++;
      }

      const fill  = document.getElementById("strengthFill");
      const label = document.getElementById("strengthLabel");
      const pct   = (passed / 5) * 100;
      fill.style.width = pct + "%";

      const levels = ["", "Weak", "Weak", "Fair", "Good", "Strong 🔒"];
      const colors = ["", "#e74c3c", "#e74c3c", "#f39c12", "#2ecc71", "#27ae60"];
      fill.style.background  = colors[passed];
      label.textContent      = levels[passed];
      label.style.color      = colors[passed];
    }
  </script>
</body>
</html>
